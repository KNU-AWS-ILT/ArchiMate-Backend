{
  "$defs": {
    "Alternative": {
      "properties": {
        "service": {
          "$ref": "#/$defs/AwsService"
        },
        "reason": {
          "description": "이 대안 대신 선택하지 않은 이유 또는 대안이 나은 상황",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "service",
        "reason"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "AwsService": {
      "description": "다이어그램 노드로 쓸 수 있는 AWS 서비스.\n\nLLM은 이 목록 밖의 서비스를 출력할 수 없다(스키마로 강제).\n프론트는 이 값으로 AWS 공식 아이콘을 매핑한다.",
      "enum": [
        "lambda",
        "s3",
        "dynamodb",
        "rds",
        "ec2",
        "cloudfront",
        "api_gateway",
        "alb",
        "ecs_fargate",
        "nat_gateway",
        "elasticache",
        "cognito",
        "route53",
        "sqs",
        "sns",
        "eventbridge",
        "cloudwatch",
        "secrets_manager",
        "ses",
        "bedrock"
      ],
      "title": "AwsService",
      "type": "string"
    },
    "Design": {
      "properties": {
        "title": {
          "description": "안 이름, 예: '서버리스 최소비용 구성'",
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "description": "구성 요약 2~3문장",
          "title": "Summary",
          "type": "string"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/Group"
          },
          "title": "Groups",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "title": "Edges",
          "type": "array"
        },
        "operation_difficulty": {
          "description": "운영 난이도 1(쉬움)~5(어려움)",
          "maximum": 5,
          "minimum": 1,
          "title": "Operation Difficulty",
          "type": "integer"
        },
        "pros": {
          "description": "장점 2~4개",
          "items": {
            "type": "string"
          },
          "title": "Pros",
          "type": "array"
        },
        "cons": {
          "description": "단점·한계 2~4개",
          "items": {
            "type": "string"
          },
          "title": "Cons",
          "type": "array"
        },
        "budget_note": {
          "description": "예산 대비 적합성 코멘트. 금액 숫자는 쓰지 않는다",
          "title": "Budget Note",
          "type": "string"
        },
        "scaling_path": {
          "description": "사용자 1만→10만 명으로 늘 때 바꿀 부분 1~3개",
          "items": {
            "type": "string"
          },
          "title": "Scaling Path",
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "title",
        "summary",
        "groups",
        "nodes",
        "edges",
        "operation_difficulty",
        "pros",
        "cons",
        "budget_note",
        "scaling_path",
        "tier"
      ],
      "title": "Design",
      "type": "object"
    },
    "Edge": {
      "properties": {
        "source": {
          "description": "출발 노드 id. 사용자 브라우저는 'user'",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "description": "도착 노드 id",
          "title": "Target",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "예: 'HTTPS 요청', '이미지 업로드'",
          "title": "Label"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Group": {
      "properties": {
        "id": {
          "description": "영문 소문자·숫자·밑줄, 예: vpc_main",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GroupKind"
        },
        "label": {
          "description": "표시 이름, 예: 'VPC (10.0.0.0/16)'",
          "title": "Label",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "상위 그룹 id. 최상위면 null",
          "title": "Parent Id"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "title": "Group",
      "type": "object"
    },
    "GroupKind": {
      "description": "다이어그램 레이어(프론트가 중첩 박스로 그림).",
      "enum": [
        "region",
        "vpc",
        "availability_zone",
        "public_subnet",
        "private_subnet"
      ],
      "title": "GroupKind",
      "type": "string"
    },
    "Node": {
      "properties": {
        "id": {
          "description": "영문 소문자·숫자·밑줄, 예: api_lambda",
          "title": "Id",
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/AwsService"
        },
        "label": {
          "description": "표시 이름, 예: 'API 처리 함수'",
          "title": "Label",
          "type": "string"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "소속 그룹 id. 그룹 밖이면 null",
          "title": "Group Id"
        },
        "role": {
          "description": "이 구성에서 하는 일 (한 줄)",
          "title": "Role",
          "type": "string"
        },
        "rationale": {
          "$ref": "#/$defs/Rationale"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "id",
        "service",
        "label",
        "role",
        "rationale",
        "usage"
      ],
      "title": "Node",
      "type": "object"
    },
    "Rationale": {
      "description": "노드 클릭 시 보여줄 '왜 이 서비스인가 / 대안 / 주의점'.",
      "properties": {
        "why": {
          "description": "이 요구사항에서 이 서비스를 고른 이유 (2~3문장)",
          "title": "Why",
          "type": "string"
        },
        "alternatives": {
          "description": "고려할 만한 대안 1~2개",
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "cautions": {
          "description": "운영·비용 주의점 1~3개",
          "items": {
            "type": "string"
          },
          "title": "Cautions",
          "type": "array"
        }
      },
      "required": [
        "why",
        "alternatives",
        "cautions"
      ],
      "title": "Rationale",
      "type": "object"
    },
    "Tier": {
      "description": "3안 구분.",
      "enum": [
        "minimal_cost",
        "balanced",
        "scalable"
      ],
      "title": "Tier",
      "type": "string"
    },
    "TierFailure": {
      "properties": {
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "tier",
        "reason"
      ],
      "title": "TierFailure",
      "type": "object"
    },
    "Usage": {
      "description": "비용 계산용 월 사용량 추정치. 서비스별 필수 항목은 REQUIRED_USAGE_FIELDS 참고.\n\n⚠️ 필드 구성은 비용 계산 담당과 합의 대상.",
      "properties": {
        "monthly_requests": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "월 요청 수",
          "title": "Monthly Requests"
        },
        "avg_duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lambda 평균 실행 시간(ms)",
          "title": "Avg Duration Ms"
        },
        "memory_mb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lambda 메모리(MB)",
          "title": "Memory Mb"
        },
        "storage_gb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "저장 용량(GB)",
          "title": "Storage Gb"
        },
        "data_transfer_out_gb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "월 외부 전송량(GB)",
          "title": "Data Transfer Out Gb"
        },
        "monthly_reads": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DynamoDB 월 읽기 요청 수",
          "title": "Monthly Reads"
        },
        "monthly_writes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DynamoDB 월 쓰기 요청 수",
          "title": "Monthly Writes"
        },
        "instance_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "예: t4g.micro, db.t4g.micro",
          "title": "Instance Type"
        },
        "instance_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "인스턴스/태스크 수",
          "title": "Instance Count"
        },
        "hours_per_month": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "월 가동 시간(상시 730)",
          "title": "Hours Per Month"
        },
        "multi_az": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RDS Multi-AZ 여부",
          "title": "Multi Az"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "description": "3안 생성 결과. 일부 안이 실패해도 성공한 안은 반환한다(5일차 게이트 대비).",
  "properties": {
    "designs": {
      "items": {
        "$ref": "#/$defs/Design"
      },
      "title": "Designs",
      "type": "array"
    },
    "failures": {
      "items": {
        "$ref": "#/$defs/TierFailure"
      },
      "title": "Failures",
      "type": "array"
    }
  },
  "required": [
    "designs"
  ],
  "title": "DesignSet",
  "type": "object"
}
