# ── LLM 설정 (LLM 담당) ─────────────────────────────
# mock | gemini | bedrock | anthropic
#   mock      : 고정 응답, 비용 0. 프론트 연동·CI 기본값
#   gemini    : Google AI Studio 무료 티어 (개발용, 입력이 Google 학습에 쓰일 수 있음 → 실제 사용자 데이터 금지)
#   bedrock   : Amazon Bedrock Claude (최종 배포용, AWS 유료 플랜 필요)
#   anthropic : Anthropic API 직접 호출 (선택, 유료)
LLM_PROVIDER=mock

# 비워두면 제공자별 기본 모델 사용 (gemini: gemini-3.5-flash-lite / bedrock: anthropic.claude-opus-5-5)
# 품질 확인은 LLM_MODEL=gemini-3.8-flash (느림: 설계 1안 약 68초)
# Bedrock은 서울 리전에서 global 라우팅이라 'global.' 접두사 없이 'anthropic.' ID를 그대로 쓴다
LLM_MODEL=

# 노드 설명용 소형 모델. 비워두면 제공자별 기본값 (gemini: gemini-3.5-flash-lite / bedrock: anthropic.claude-haiku-5-5)
LLM_EXPLAIN_MODEL=

# 스키마 검증 실패 시 재시도 횟수, LLM 1회 호출 타임아웃(초)
LLM_MAX_VALIDATION_RETRIES=2
LLM_REQUEST_TIMEOUT_S=50

# 전체 기한(초). 호출마다 남은 시간만 기다리고, 부족하면 재시도하지 않는다
#   설계 생성: Lambda 180초 안에서 비용 계산·저장 여유 30초를 남긴다
#   노드 설명: Lambda 25초·API Gateway 29초 안에서 항상 에러 형식으로 응답
LLM_GENERATION_DEADLINE_S=150
LLM_EXPLAIN_DEADLINE_S=20

# 생성할 안 (쉼표 구분). 비우면 3안 전체. 1안으로 줄일 때: LLM_TIERS=minimal_cost
LLM_TIERS=

# 일시 오류(429 한도 초과, 5xx 과부하, 네트워크 끊김) 재시도 횟수와 첫 대기 시간(초)
#   대기: 1초 → 2초 → 4초 (+ 무작위 0~1초). 전체 기한 안에서만 재시도한다
LLM_MAX_TRANSIENT_RETRIES=3
LLM_RETRY_BASE_DELAY_S=1

# 설계용 모델이 한도 초과(429)·과부하(503)로 계속 실패하면 1회 시도할 대체 모델. 비우면 사용 안 함 (노드 설명은 적용 안 함)
#   예) gemini: gemini-3.8-flash (무료 한도가 모델별로 따로 잡힌다. 느리지만 기한 안에서 동작)
LLM_FALLBACK_MODEL=

# Claude 추론 깊이 (low | medium | high) — 60초 목표 때문에 기본 low
LLM_CLAUDE_EFFORT=low

# Claude 경로 시스템 프롬프트 캐시. Bedrock에서 실제로 동작하는지 확인한 뒤 true로 켠다
LLM_PROMPT_CACHE=false

# LLM 1회 출력 최대 토큰 (설계안 JSON이 잘리면 늘린다)
LLM_MAX_OUTPUT_TOKENS=16000

# Gemini: https://aistudio.google.com/apikey 에서 발급 (프로젝트 단위 무료 한도)
GEMINI_API_KEY=

# Bedrock: AWS 자격 증명은 표준 방식(AWS_PROFILE 또는 IAM 역할)으로 주입
AWS_REGION=ap-northeast-2
# AWS_PROFILE=archimate

# Anthropic 직접 호출 시
# ANTHROPIC_API_KEY=

# ── API 서버 설정 (API·비용 담당) ─────────────────────
# Swagger UI(/docs)·ReDoc(/redoc)·/openapi.json 노출 여부. AWS 배포에서는 false 권장
API_DOCS_ENABLED=true
# 브라우저 호출을 허용할 프론트 주소 (JSON 배열)
API_CORS_ORIGINS=["http://localhost:3000"]
# 모킹 지연(초). 프론트에서 queued → running → 안이 하나씩 채워지는 흐름을 볼 때 2 정도로. LLM_PROVIDER=mock일 때만 적용
MOCK_DELAY_S=0


# ── AWS Lambda 배포 전용 (로컬·Railway에서는 비워 둔다. 이름은 이슈 #15에서 확정) ─────
# DESIGNS_TABLE=
# EXPLANATIONS_TABLE=
# 단가 테이블. 없으면 패키지 스냅샷(pricing/snapshots/) 단가로 월 비용을 계산한다
# PRICES_TABLE=
